# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Gaming Platforms API Configuration (Optional - public lookups work out-of-the-box)
# Steam Web API: Obtain at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""

# Riot Games Developer API: Obtain at https://developer.riotgames.com/
RIOT_API_KEY=""

# Fortnite-API: Obtain at https://fortnite-api.com/
FORTNITE_API_KEY=""

# Xbox Live (OpenXBL): Obtain at https://xbl.io/
OPENXBL_API_KEY=""
